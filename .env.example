# QA, Converter and Corpus CLI require no environment variables.
# Optional server-only translation API; no UI is connected.
# Disabled unless exactly true. Keep disabled on public deployments without access controls.
TRANSLATION_API_ENABLED=
# Never put real credentials in this example or use NEXT_PUBLIC_ for these variables.
# Server OpenAI API key (required only when constructing the adapter).
OPENAI_API_KEY=
# Model supporting Responses API and Strict Structured Outputs; no default model.
OPENAI_TRANSLATION_MODEL=
